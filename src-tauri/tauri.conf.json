{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResTeaM",
  "mainBinaryName": "ResTeaM",
  "version": "0.1.0",
  "identifier": "com.yiuno.resteam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResTeaM",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "maximized": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#09090A"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://img.localhost https://img.localhost https://*.steamstatic.com https://*.akamaihd.net https://*.steampowered.com",
        "connect-src": "ipc: http://ipc.localhost https://video.akamai.steamstatic.com https://video.fastly.steamstatic.com",
        "media-src": "'self' blob: https://video.akamai.steamstatic.com https://video.fastly.steamstatic.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
